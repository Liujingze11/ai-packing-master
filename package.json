{
  "name": "ai-packing-engine",
  "productName": "AI 装箱引擎",
  "version": "0.1.0",
  "private": true,
  "description": "AI 装箱推荐桌面演示（SmartPackingEngine Desktop Demo）",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "papaparse": "^5.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "41.10.3",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "electron@41.10.3": true,
    "esbuild@0.25.12": true
  }
}
